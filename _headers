/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# HTML は常に最新が配信されるため、HTML から読み込む CSS / JS / データを
# キャッシュすると「新しい HTML × 古い JS」の食い違いが起きる。
# no-cache = 保存はするが毎回サーバーに確認する（変更なしなら 304 で数百バイト）。
/assets/style.css
  Cache-Control: no-cache

/assets/main.js
  Cache-Control: no-cache

/assets/data.json
  Cache-Control: no-cache

# アイコンとスクリーンショットは同名で内容が変わらないため長期キャッシュしてよい
/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/assets/lp.css
  Cache-Control: no-cache

# app-ads.txt は Google のクローラーが読む。内容変更を素早く反映させたいので短めに
/app-ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
