/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# HTML は常に最新が配信されるため、HTML から読み込む CSS / JS / データを
# キャッシュすると「新しい HTML × 古い JS」の食い違いが起きる。
# no-cache = 保存はするが毎回サーバーに確認する（変更なしなら 304 で数百バイト）。
/assets/style.css
  Cache-Control: no-cache

/assets/main.js
  Cache-Control: no-cache

/assets/data.json
  Cache-Control: no-cache

# サントラの音源。内容が変わらないので長期キャッシュ。
# **1 曲 2〜3MB あるので、ここをキャッシュしないと聴き直すたびに取り直しになる**
/apps/subarashii-ana/audio/*
  Cache-Control: public, max-age=31536000, immutable

# アイコンとスクリーンショットは同名のまま差し替わる(アプリの更新でアイコンや
# スクショが変わる)。immutable にしていたため、差し替えても手元のブラウザが
# 1年間取り直さず、古い絵が出たままになった。
# 1日で再検証し、その後1週間は古いものを表示しつつ裏で取り直す
/assets/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/screenshots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/lp.css
  Cache-Control: no-cache

# app-ads.txt は Google のクローラーが読む。内容変更を素早く反映させたいので短めに
/app-ads.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# アプリが読む設定ファイル。すぐ反映させたいのでキャッシュしない
/config/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *

# Universal Link の紐付けファイル。Apple は application/json で、かつ
# リダイレクトなしで返ってくることを求める。拡張子が無いので明示する
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
